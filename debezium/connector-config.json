{
  "name": "shopflow-postgres-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",

    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "shopflow",
    "database.password": "shopflow",
    "database.dbname": "shopflow",

    "topic.prefix": "shopflow",

    "plugin.name": "pgoutput",
    "slot.name": "shopflow_slot",
    "publication.name": "shopflow_pub",
    "publication.autocreate.mode": "filtered",

    "schema.include.list": "public",
    "table.include.list": "public.customers,public.products,public.sellers,public.product_category_translation,public.orders,public.order_items,public.payments,public.reviews,public.returns",

    "snapshot.mode": "initial",
    "snapshot.locking.mode": "none",
    "include.schema.changes": "false",

    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",

    "tombstones.on.delete": "false",
    "decimal.handling.mode": "double",
    "time.precision.mode": "connect",
    "heartbeat.interval.ms": "10000",
    "heartbeat.action.query": "SELECT 1"
  }
}
